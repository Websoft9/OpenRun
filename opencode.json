{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 20000,
      "catalog": 15000,
      "execution": 60000
    },
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PAT}",
          "X-MCP-Toolsets": "repos,issues,pull_requests,users",
          "X-MCP-Readonly": "true"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "environment": {
          "PLAYWRIGHT_MCP_HEADLESS": "true",
          "PLAYWRIGHT_MCP_BROWSER": "chromium"
        },
        "timeout": {
          "startup": 30000,
          "catalog": 15000,
          "execution": 120000
        }
      },
      "fetch": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@yawlabs/fetch-mcp@latest"
        ],
        "timeout": {
          "startup": 30000,
          "catalog": 15000,
          "execution": 120000
        }
      },
      "sqlite": {
        "type": "local",
        "cwd": ".",
        "command": [
          "npx",
          "-y",
          "@mrfentmen/sqlite-mcp",
          "data/openrun.sqlite"
        ],
        "timeout": {
          "startup": 20000,
          "catalog": 15000,
          "execution": 60000
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow"
    },
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "external_directory": {
      "*": "deny",
      "/tmp": "allow",
      "/tmp/**": "allow"
    }
  }
}
